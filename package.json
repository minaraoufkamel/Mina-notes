{
  "name": "mina-notes",
  "productName": "Mina Notes",
  "version": "1.0.0",
  "description": "Visual boards for notes, tasks and nested diagrams",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "local.minanotes.app",
    "productName": "Mina Notes",
    "files": [
      "main.js",
      "ai-main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mina Notes uses the microphone to record audio notes."
      }
    },
    "dmg": {
      "title": "Mina Notes"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0"
  }
}
